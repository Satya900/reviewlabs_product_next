# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Razorpay (use rzp_test_ keys while developing) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Creator plan ids (₹299 monthly, ₹2,999 yearly). Create them with:
#   node scripts/create-razorpay-plan.mjs   (once with test keys, once with live keys)
RAZORPAY_PLAN_MONTHLY_ID=
RAZORPAY_PLAN_YEARLY_ID=

# --- RazorpayX payouts ---
# RazorpayX → Settings → Developer Controls → API Keys (separate from the payment keys above).
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# RazorpayX → Account details → Account number (the account payouts are sent from).
# Payouts stay off while this is empty.
RAZORPAYX_ACCOUNT_NUMBER=
# RazorpayX → Settings → Webhooks, URL https://reviewlabs.space/api/webhooks/razorpayx,
# events payout.processed, payout.reversed, payout.failed, payout.rejected, payout.updated, payout.initiated.
RAZORPAYX_WEBHOOK_SECRET=
# Set to "off" to stop the daily automatic payouts (admins can still pay manually).
AUTO_PAYOUTS=on

# --- Email (Resend). If empty, emails are logged to the console. ---
RESEND_API_KEY=
EMAIL_FROM="Reviewlabs <no-reply@reviewlabs.space>"

# --- Meta Conversions API ---
META_GRAPH_VERSION=v24.0

# --- Downloads ---
# 0 = lifetime access (links never expire)
DOWNLOAD_LINK_TTL_DAYS=0
# Downloads per link before the buyer must request a fresh link by email
DOWNLOAD_MAX_PER_GRANT=50
